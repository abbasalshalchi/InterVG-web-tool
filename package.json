{
  "name": "lerpa-player",
  "version": "0.2.2",
  "description": "Interactive vector animations for the web. A .lerpa is a valid SVG that also animates.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Abbas Alshalchi <abbasalshalchi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbasalshalchi/lerpa.git"
  },
  "bugs": {
    "url": "https://github.com/abbasalshalchi/lerpa/issues"
  },
  "homepage": "https://github.com/abbasalshalchi/lerpa#readme",
  "keywords": [
    "svg",
    "animation",
    "vector",
    "canvas",
    "blender",
    "lottie-alternative",
    "lerpa"
  ],
  "sideEffects": [
    "./src/index.js"
  ],
  "exports": {
    ".": "./src/index.js",
    "./react": "./src/react.js",
    "./player": "./src/player.js",
    "./element": "./src/element.js",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "COMMERCIAL.md"
  ],
  "bin": {
    "lerpa": "bin/lerpa.js"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "test": "node -e \"import('./src/index.js').then(m=>{for(const k of ['LerpaPlayer','load','defineElement','fetchDocument','parseDocument'])if(!m[k])throw new Error('missing export: '+k);console.log('exports ok, ssr-safe')})\"",
    "prepublishOnly": "npm test"
  }
}
